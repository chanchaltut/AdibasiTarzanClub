# ─────────────────────────────────────────────────────────────
# Website settings. Copy to ".env.local" for your computer.
# On Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# The API server address, no slash at the end.
# Leave empty on your computer: "/api" is then forwarded to http://localhost:4000.
VITE_API_URL=

# Optional: a different address for the build to read content from (normally the same as above).
# ATC_API_URL=

# Only set to 1 if you deliberately want to build with the sample content while the API is down.
# ALLOW_DEFAULT_CONTENT=
